{
  "name": "3d-model-downloader",
  "version": "1.3.0",
  "description": "Universal 3D model downloader and multi-format exporter for web-based 3D generation platforms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox ",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@types/three": "^0.185.4",
    "@wxt-dev/module-svelte": "latest",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.1.1",
    "svelte": "latest",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "typescript": "latest",
    "vitest": "^5.0.0",
    "wxt": "^0.20.26"
  }
}
